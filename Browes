local radarSection = Tabs.Radar:AddSection("Radar", "solar/map-bold")
local radarEnabled = false
local radarSize = 150
local radarGui = Instance.new("ScreenGui")
radarGui.Parent = LocalPlayer.PlayerGui
radarGui.ResetOnSpawn = false

local radarFrame = Instance.new("Frame")
radarFrame.Size = UDim2.new(0, radarSize, 0, radarSize)
radarFrame.Position = UDim2.new(0.02, 0, 0.85, 0) -- bottom-left
radarFrame.BackgroundColor3 = Color3.fromRGB(20,20,30)
radarFrame.BackgroundTransparency = 0.3
radarFrame.BorderSizePixel = 1
radarFrame.BorderColor3 = Color3.fromRGB(255,255,255)
radarFrame.Parent = radarGui
radarFrame.Visible = false

local function updateRadar()
    if not radarEnabled then
        radarFrame.Visible = false
        return
    end
    radarFrame.Visible = true
    for _, child in ipairs(radarFrame:GetChildren()) do
        if child.Name == "Dot" then child:Destroy() end
    end
    local center = radarFrame.AbsoluteSize / 2
    local playerPos = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not playerPos then return end
    local pPos = playerPos.Position
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local char = player.Character
            if char then
                local root = char:FindFirstChild("HumanoidRootPart")
                if root then
                    local rel = root.Position - pPos
                    local dist = rel.Magnitude
                    if dist < 200 then -- radar range
                        local scale = radarSize / 400
                        local dot = Instance.new("Frame")
                        dot.Name = "Dot"
                        dot.Size = UDim2.new(0, 4, 0, 4)
                        dot.BackgroundColor3 = Color3.fromRGB(255,0,0)
                        dot.BorderSizePixel = 0
                        dot.Parent = radarFrame
                        dot.Position = UDim2.new(0, center.X + rel.X * scale, 0, center.Y + rel.Z * scale)
                    end
                end
            end
        end
    end
end

