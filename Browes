local espColor = Color3.fromRGB(0, 255, 255)
local espDistance = 300
local espObjects = {}

local function createESP(p)
    if p == LocalPlayer then return end
    local c = p.Character
    if not c then return end
    local r = c:FindFirstChild("HumanoidRootPart")
    if not r then return end

    local name = Instance.new("TextLabel")
    name.Size = UDim2.new(0, 200, 0, 20)
    name.BackgroundTransparency = 1
    name.Text = p.Name
    name.TextColor3 = espColor
    name.TextStrokeTransparency = 0.5
    name.Font = Enum.Font.GothamBold
    name.TextSize = 14
    name.Parent = LocalPlayer.PlayerGui
    name.Visible = false

    local hb = Instance.new("Frame")
    hb.Size = UDim2.new(0, 100, 0, 4)
    hb.BackgroundColor3 = Color3.fromRGB(0,255,0)
    hb.BorderSizePixel = 0
    hb.Parent = LocalPlayer.PlayerGui
    hb.Visible = false
    local hbg = Instance.new("Frame")
    hbg.Size = UDim2.new(1,0,1,0)
    hbg.BackgroundColor3 = Color3.fromRGB(30,30,30)
    hbg.BorderSizePixel = 0
    hbg.Parent = hb
    local hfill = Instance.new("Frame")
    hfill.Size = UDim2.new(1,0,1,0)
    hfill.BackgroundColor3 = Color3.fromRGB(0,255,0)
    hfill.BorderSizePixel = 0
    hfill.Parent = hb

    local box = Instance.new("Frame")
    box.Size = UDim2.new(0, 60, 0, 80)
    box.BackgroundTransparency = 0.5
    box.BackgroundColor3 = espColor
    box.BorderSizePixel = 1
    box.BorderColor3 = espColor
    box.Parent = LocalPlayer.PlayerGui
    box.Visible = false

    espObjects[p] = { name, hb, hfill, box }
end

local function removeESP(p)
    local o = espObjects[p]
    if o then
        for _, obj in ipairs(o) do obj:Destroy() end
        espObjects[p] = nil
    end
end

local function updateESP()
    if not espEnabled then
        for _, o in pairs(espObjects) do
            for _, obj in ipairs(o) do obj.Visible = false end
        end
        return
    end
    local cam = Camera
    local vp = cam.ViewportSize
    for p, o in pairs(espObjects) do
        local c = p.Character
        if not c then
            for _, obj in ipairs(o) do obj.Visible = false end
            continue
        end
        local r = c:FindFirstChild("HumanoidRootPart")
        if not r then
            for _, obj in ipairs(o) do obj.Visible = false end
            continue
        end
        local pos, on = cam:WorldToViewportPoint(r.Position)
        local dist = (r.Position - cam.CFrame.Position).Magnitude
        if on and dist <= espDistance then
            local name, hb, hfill, box = unpack(o)
            name.Visible = espSettings.Names
            hb.Visible = espSettings.Health
            box.Visible = espSettings.Boxes

            if espSettings.Names then
                name.Position = UDim2.new(0, pos.X - 100, 0, pos.Y - 40)
                name.TextColor3 = espColor
            end
            if espSettings.Health then
                hb.Position = UDim2.new(0, pos.X - 50, 0, pos.Y - 20)
                local hum = c:FindFirstChild("Humanoid")
                if hum then
                    local hp = hum.Health / hum.MaxHealth
                    hfill.Size = UDim2.new(math.clamp(hp,0,1), 0, 1, 0)
                    hfill.BackgroundColor3 = Color3.fromRGB(255*(1-hp), 255*hp, 0)
                end
            end
            if espSettings.Boxes then
                box.Position = UDim2.new(0, pos.X - 30, 0, pos.Y - 40)
                box.BackgroundColor3 = espColor
                box.BorderColor3 = espColor
            end
        else
            for _, obj in ipairs(o) do obj.Visible = false end
        end
    end
end

