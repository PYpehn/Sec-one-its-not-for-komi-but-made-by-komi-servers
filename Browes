local espEnabled = false
local espSettings = { Names = true, Boxes = false, Health = true, Tracers = false }
local espColor = Color3.fromRGB(0, 255, 255)
local espDistance = 300
local espObjects = {}

local function createESP(player)
    if player == LocalPlayer then return end
    local char = player.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end

    local nameLabel = Instance.new("TextLabel")
    nameLabel.Size = UDim2.new(0, 200, 0, 20)
    nameLabel.BackgroundTransparency = 1
    nameLabel.Text = player.Name
    nameLabel.TextColor3 = espColor
    nameLabel.TextStrokeTransparency = 0.5
    nameLabel.Font = Enum.Font.GothamBold
    nameLabel.TextSize = 14
    nameLabel.Parent = LocalPlayer.PlayerGui
    nameLabel.Visible = false

    local healthBar = Instance.new("Frame")
    healthBar.Size = UDim2.new(0, 100, 0, 4)
    healthBar.BackgroundColor3 = Color3.fromRGB(0,255,0)
    healthBar.BorderSizePixel = 0
    healthBar.Parent = LocalPlayer.PlayerGui
    healthBar.Visible = false
    local healthBg = Instance.new("Frame")
    healthBg.Size = UDim2.new(1,0,1,0)
    healthBg.BackgroundColor3 = Color3.fromRGB(30,30,30)
    healthBg.BorderSizePixel = 0
    healthBg.Parent = healthBar
    local healthFill = Instance.new("Frame")
    healthFill.Size = UDim2.new(1,0,1,0)
    healthFill.BackgroundColor3 = Color3.fromRGB(0,255,0)
    healthFill.BorderSizePixel = 0
    healthFill.Parent = healthBar

    local box = Instance.new("Frame")
    box.Size = UDim2.new(0, 60, 0, 80)
    box.BackgroundTransparency = 0.5
    box.BackgroundColor3 = espColor
    box.BorderSizePixel = 1
    box.BorderColor3 = espColor
    box.Parent = LocalPlayer.PlayerGui
    box.Visible = false

    local tracer = Instance.new("Frame")
    tracer.Size = UDim2.new(0, 2, 0, 100)
    tracer.BackgroundColor3 = espColor
    tracer.BackgroundTransparency = 0.5
    tracer.Parent = LocalPlayer.PlayerGui
    tracer.Visible = false

    espObjects[player] = { nameLabel, healthBar, healthFill, box, tracer }
end

local function removeESP(player)
    local objs = espObjects[player]
    if objs then
        for _, obj in ipairs(objs) do obj:Destroy() end
        espObjects[player] = nil
    end
end

local function updateESP()
    if not espEnabled then
        for _, objs in pairs(espObjects) do
            for _, obj in ipairs(objs) do obj.Visible = false end
        end
        return
    end

    local camera = Camera
    local viewport = camera.ViewportSize
    for player, objs in pairs(espObjects) do
        local char = player.Character
        if not char then
            for _, obj in ipairs(objs) do obj.Visible = false end
            continue
        end
        local root = char:FindFirstChild("HumanoidRootPart")
        if not root then
            for _, obj in ipairs(objs) do obj.Visible = false end
            continue
        end
        local pos, onScreen = camera:WorldToViewportPoint(root.Position)
        local dist = (root.Position - camera.CFrame.Position).Magnitude
        if onScreen and dist <= espDistance then
            local nameLabel, healthBar, healthFill, box, tracer = unpack(objs)
            nameLabel.Visible = espSettings.Names
            healthBar.Visible = espSettings.Health
            box.Visible = espSettings.Boxes
            tracer.Visible = espSettings.Tracers

            if espSettings.Names then
                nameLabel.Position = UDim2.new(0, pos.X - 100, 0, pos.Y - 40)
                nameLabel.TextColor3 = espColor
            end
            if espSettings.Health then
                healthBar.Position = UDim2.new(0, pos.X - 50, 0, pos.Y - 20)
                local humanoid = char:FindFirstChild("Humanoid")
                if humanoid then
                    local hp = humanoid.Health / humanoid.MaxHealth
                    healthFill.Size = UDim2.new(math.clamp(hp,0,1), 0, 1, 0)
                    healthFill.BackgroundColor3 = Color3.fromRGB(255 * (1 - hp), 255 * hp, 0)
                end
            end
            if espSettings.Boxes then
                box.Position = UDim2.new(0, pos.X - 30, 0, pos.Y - 40)
                box.BackgroundColor3 = espColor
                box.BorderColor3 = espColor
            end
            if espSettings.Tracers then
                tracer.Position = UDim2.new(0, pos.X - 1, 0, pos.Y + 20)
                local height = viewport.Y - pos.Y - 20
                tracer.Size = UDim2.new(0, 2, 0, math.max(height, 0))
                tracer.BackgroundColor3 = espColor
            end
        else
            for _, obj in ipairs(objs) do obj.Visible = false end
        end
    end
end

