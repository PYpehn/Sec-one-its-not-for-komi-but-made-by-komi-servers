local function removeESP(p) local o=espObjects[p]; if o then for _,obj in ipairs(o) do obj:Destroy() end; espObjects[p]=nil end end
local function updateESP()
    if not espEnabled then for _,o in pairs(espObjects) do for _,obj in ipairs(o) do obj.Visible=false end end return end
    local cam=Camera; local vp=cam.ViewportSize
    for p,o in pairs(espObjects) do
        local c=p.Character; if not c then for _,obj in ipairs(o) do obj.Visible=false end continue end
        local r=c:FindFirstChild("HumanoidRootPart"); if not r then for _,obj in ipairs(o) do obj.Visible=false end continue end
        local pos, on = cam:WorldToViewportPoint(r.Position); local dist=(r.Position-cam.CFrame.Position).Magnitude
        if on and dist<=espDistance then
            local name, hb, hfill, box, tracer = unpack(o)
            name.Visible=espSettings.Names; hb.Visible=espSettings.Health; box.Visible=espSettings.Boxes; tracer.Visible=espSettings.Tracers
            if espSettings.Names then name.Position=UDim2.new(0,pos.X-100,0,pos.Y-40); name.TextColor3=espColor end
            if espSettings.Health then
                hb.Position=UDim2.new(0,pos.X-50,0,pos.Y-20)
                local hum=c:FindFirstChild("Humanoid"); if hum then local hp=hum.Health/hum.MaxHealth; hfill.Size=UDim2.new(math.clamp(hp,0,1),0,1,0); hfill.BackgroundColor3=Color3.fromRGB(255*(1-hp),255*hp,0) end
            end
            if espSettings.Boxes then box.Position=UDim2.new(0,pos.X-30,0,pos.Y-40); box.BackgroundColor3=espColor; box.BorderColor3=espColor end
            if espSettings.Tracers then tracer.Position=UDim2.new(0,pos.X-1,0,pos.Y+20); local h=vp.Y-pos.Y-20; tracer.Size=UDim2.new(0,2,0,math.max(h,0)); tracer.BackgroundColor3=espColor end
        else
            for _,obj in ipairs(o) do obj.Visible=false end
        end
    end
end
